# Host ports of the docker compose stack. The defaults work out of the box;
# change them only if a port is already taken on the machine. compose reads
# this file, and POSTGRES_PORT / REDIS_PORT are also the defaults the app and
# the test suite use when DATABASE_URL / REDIS_URL are not set explicitly.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=3000
METRICS_PORT=9100

# PostgreSQL (source of truth)
DATABASE_URL=postgres://leaderboard:leaderboard@localhost:5433/leaderboard
PG_POOL_SIZE=10
# Redis (read model)
REDIS_URL=redis://localhost:6380/0
# API
PORT=3000
SEASON_CACHE_TTL_MS=1000
TOP_MAX_LIMIT=1000
RANK_MAX_N=50
PLAYER_ID_MAX_LEN=128
# Worker
WORKER_BATCH_SIZE=500
WORKER_POLL_INTERVAL_MS=50
WORKER_IDLE_CHECK_INTERVAL_MS=5000
WORKER_METRICS_PORT=9100
LOG_LEVEL=info
